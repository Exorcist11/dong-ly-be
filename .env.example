# ==============================================================================
# Biến môi trường mẫu cho ứng dụng Backend (Dong Ly Platform)
# TUYỆT ĐỐI KHÔNG điền mật khẩu hoặc khóa thật vào file mẫu này!
# ==============================================================================

# Profile hoạt động: dev, prod, test
SPRING_PROFILES_ACTIVE=dev

# Cổng dịch vụ HTTP (Mặc định 8080, Render tự cấp cổng động)
PORT=8080

# Kết nối cơ sở dữ liệu PostgreSQL
# - Dev cục bộ: jdbc:postgresql://localhost:5432/dongly_dev
# - Prod (Neon): jdbc:postgresql://<project-id>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/dongly_dev
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres_dev_password

# Bảo mật & JSON Web Token (JWT)
# Bắt buộc chuỗi bí mật ngẫu nhiên tối thiểu 256 bits (32 bytes)
JWT_SECRET=your-random-jwt-secret-key-minimum-32-characters-length-here
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=1800
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=604800

# Cấu hình danh sách tên miền được phép truy cập CORS (phân tách bởi dấu phẩy)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200
